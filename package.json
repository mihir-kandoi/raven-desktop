{
  "name": "raven-desktop",
  "productName": "Raven",
  "version": "2.8.11",
  "description": "Raven desktop client",
  "private": true,
  "type": "module",
  "main": ".desktop-build/bundle/main.cjs",
  "repository": "https://github.com/mihir-kandoi/raven-desktop",
  "license": "AGPL-3.0-only",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && esbuild .desktop-build/main.js --bundle --platform=node --format=cjs --external:electron --outfile=.desktop-build/bundle/main.cjs && esbuild src/site-preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=.desktop-build/site-preload.cjs",
    "typecheck": "tsc --noEmit",
    "start": "yarn build && electron-forge start",
    "package": "yarn build && electron-forge package",
    "make": "yarn build && electron-forge make",
    "raven:update": "git submodule update --remote raven",
    "test": "vitest run --dir tests",
    "test:electron": "yarn build && node scripts/run-electron-smoke.cjs"
  },
  "dependencies": {
    "socket.io-client": "4.7.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.0.0",
    "electron": "^44.0.0",
    "esbuild": "0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
